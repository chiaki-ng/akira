# Build NRO
set(BUILD_FONT_DIR ${CMAKE_BINARY_DIR}/resources/font)
set(AKIRA_PRUNE_RESOURCES)
foreach (resource IN LISTS AKIRA_FOREIGN_RESOURCES)
    list(APPEND AKIRA_PRUNE_RESOURCES ${CMAKE_BINARY_DIR}/resources/${resource})
endforeach()
set(AKIRA_PRUNE_COMMAND)
if (AKIRA_PRUNE_RESOURCES)
    set(AKIRA_PRUNE_COMMAND COMMAND ${CMAKE_COMMAND} -E rm -rf ${AKIRA_PRUNE_RESOURCES})
endif()
add_custom_target(${PROJECT_NAME}.nro
    DEPENDS ${PROJECT_NAME}
    COMMAND ${NX_NACPTOOL_EXE} --create "${APP_TITLE}" "${PROJECT_AUTHOR}" "${APP_VERSION_NACP}" ${PROJECT_NAME}.nacp
    COMMAND ${CMAKE_COMMAND} -E copy_directory ${PROJECT_RESOURCES} ${CMAKE_BINARY_DIR}/resources
    ${AKIRA_PRUNE_COMMAND}
    COMMAND ${NX_ELF2NRO_EXE} ${PROJECT_NAME}.elf ${PROJECT_NAME}.nro
        --icon=${PROJECT_ICON}
        --nacp=${PROJECT_NAME}.nacp
        --romfsdir=${CMAKE_BINARY_DIR}/resources
    ALL
)
