<brls:Box
    width="100%"
    height="100%"
    axis="column"
    alignItems="center"
    justifyContent="center"
    backgroundColor="@theme/brls/background"
    paddingTop="32"
    paddingLeft="60"
    paddingRight="60"
    paddingBottom="32">

    <brls:Label
        text="@i18n/akira/qr_sign_in/title"
        fontSize="30"
        textColor="@theme/brls/text"
        horizontalAlign="center"
        width="1040"
        shrink="0"/>

    <brls:Label
        text="@i18n/akira/qr_sign_in/subtitle"
        fontSize="17"
        textColor="@theme/akira/text_muted"
        horizontalAlign="center"
        width="1040"
        shrink="0"
        marginTop="8"
        marginBottom="24"/>

    <brls:Box
        id="qr_sign_in/card"
        width="1040"
        height="420"
        shrink="0"
        axis="row"
        alignItems="center"
        cornerRadius="14"
        paddingTop="30"
        paddingBottom="30"
        paddingLeft="30"
        paddingRight="40">

        <brls:Box
            id="qr_sign_in/tile"
            width="360"
            height="360"
            shrink="0"
            axis="column"
            alignItems="center"
            justifyContent="center"
            cornerRadius="12">

            <brls:Label
                id="qr_sign_in/placeholder"
                text="@i18n/akira/qr_sign_in/placeholder"
                fontSize="18"
                textColor="@theme/akira/text_muted"
                horizontalAlign="center"
                width="300"/>
        </brls:Box>

        <brls:Box
            width="auto"
            height="360"
            grow="1"
            axis="column"
            justifyContent="center"
            marginLeft="40">

            <brls:Label
                text="@i18n/akira/qr_sign_in/step_scan"
                fontSize="19"
                textColor="@theme/brls/text"
                shrink="0"
                marginBottom="12"/>

            <brls:Label
                text="@i18n/akira/qr_sign_in/step_approve"
                fontSize="19"
                textColor="@theme/brls/text"
                shrink="0"/>

            <brls:Label
                id="qr_sign_in/timer"
                text=""
                fontSize="16"
                textColor="@theme/akira/text_muted"
                shrink="0"
                marginTop="20"/>

            <brls:Label
                id="qr_sign_in/status"
                text=""
                fontSize="18"
                textColor="@theme/akira/text_muted"
                shrink="0"
                marginTop="18"/>
        </brls:Box>
    </brls:Box>

    <brls:Box
        width="auto"
        height="auto"
        shrink="0"
        axis="row"
        justifyContent="center"
        marginTop="22">

        <brls:Button
            id="qr_sign_in/retry"
            text="@i18n/akira/qr_sign_in/retry"
            style="primary"
            visibility="gone"
            marginRight="16"/>

        <brls:Button
            id="qr_sign_in/close"
            text="@i18n/akira/common/close"
            style="bordered"/>
    </brls:Box>

</brls:Box>
