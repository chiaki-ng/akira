<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">
	
	<brls:Label
        text="@i18n/akira/settings/build_info_tab"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            id="info/container"
            width="auto"
            height="auto"
            axis="column"
			backgroundColor="@theme/color/card"
			cornerRadius="14"
			paddingLeft="30"
			paddingRight="30"
			paddingBottom="25"
			paddingTop="25"
            grow="1.0"/>

    </brls:ScrollingFrame>

</brls:Box>
